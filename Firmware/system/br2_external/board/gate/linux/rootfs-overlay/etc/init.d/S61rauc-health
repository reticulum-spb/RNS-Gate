#!/bin/sh

TAG="rauc-health"
PIDFILE="/run/rauc-health.pid"
WDPIDFILE="/run/watchdog-kick.pid"

log()
{
    logger -t "$TAG" "$*"
}

start_watchdog()
{
    if [ ! -e /dev/watchdog ] && [ ! -e /dev/watchdog0 ]; then
        log "Watchdog device not found"
        return
    fi

    WDDEV="/dev/watchdog"
    [ -e /dev/watchdog0 ] && WDDEV="/dev/watchdog0"

    log "Starting watchdog keepalive using $WDDEV"

    (
        exec 3>"$WDDEV"

        if [ $? -ne 0 ]; then
            log "ERROR: cannot open watchdog device $WDDEV"
            exit 1
        fi

        log "Watchdog device opened"

        while :; do
            echo 1 >&3

            if [ $? -eq 0 ]; then
                log "Watchdog kick successful"
            else
                log "ERROR: watchdog kick failed"
            fi

            sleep 10
        done
    ) &

    echo $! > "$WDPIDFILE"

    log "Watchdog keepalive started with PID $(cat $WDPIDFILE)"
}

stop_watchdog()
{
    if [ -f "$WDPIDFILE" ]; then
        pid=$(cat "$WDPIDFILE")

        kill "$pid" 2>/dev/null || true

        rm -f "$WDPIDFILE"

        log "Watchdog keepalive stopped"
    fi
}

case "$1" in
    start)
        log "Starting health confirmation service"

        start_watchdog

        (
            log "Waiting 60 seconds before starting health checks"
            sleep 60
            log "Initial delay completed, starting health check loop"

            while :; do
                app_ok=0
                mount_ok=0

                if pidof rnsd-rs >/dev/null 2>&1; then
                    app_ok=1
                else
                    log "Health check failed: rnsd-rs is not running"
                fi

                if mountpoint -q /mnt; then
                    mount_ok=1
                else
                    log "Health check failed: /mnt is not mounted"
                fi

                if [ "$app_ok" -eq 1 ] && [ "$mount_ok" -eq 1 ]; then
                    log "Health check passed"

                    if rauc status mark-good; then
                        log "Boot health confirmation completed (rauc mark-good)"
                    else
                        log "ERROR: rauc status mark-good failed"
                    fi
                fi

                sleep 10
            done
        ) &

        pid=$!
        echo "$pid" > "$PIDFILE"

        log "Health confirmation service started with PID $pid"
        ;;

    stop)
        log "Stopping health confirmation service"

        if [ -f "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE")" 2>/dev/null || true
            rm -f "$PIDFILE"
        fi

        stop_watchdog
        ;;

    restart)
        "$0" stop
        "$0" start
        ;;

    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
