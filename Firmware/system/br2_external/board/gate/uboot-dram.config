# DRAM tuning for the 512MB H3 variant of the Orange Pi Zero.
#
# Mainline orangepi_zero_defconfig runs DRAM at 624 MHz, tuned for the
# original 256MB H2+ board. Armbian ships 408 MHz for this board (their
# orangepi-r1 patch states outright that 624 "is unstable on these
# boards"), and the closest analogues — Banana Pi M2 Zero (H2+/512MB)
# and the NanoPi H3 line — all run 408 in mainline. Kernel early_memtest
# confirmed bad cells at 624 on our board.
#
# ZQ/ODT are re-asserted at their H3 defaults (every H3 board in both
# mainline and Armbian uses exactly these values).
#
# SYS_CLK_FREQ 1008->480 MHz follows Armbian's patch: it removes supply
# droop as a variable while validating DRAM. Consider raising it back
# once memtest is clean.
CONFIG_DRAM_CLK=408
CONFIG_DRAM_ZQ=3881979
CONFIG_DRAM_ODT_EN=y
CONFIG_SYS_CLK_FREQ=480000000
